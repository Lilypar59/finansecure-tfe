# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  Dockerfile: FinanSecure Frontend - Compilación MULTI-STAGE                 ║
# ║  Resuelve el error "dist/not found" en GitHub Actions                      ║
# ║  Mantiene la imagen final ligera (Nginx Alpine)                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# --- ETAPA 1: Compilación (Build) ---
FROM node:18-alpine AS build-stage
WORKDIR /app

# Copiar archivos de dependencias primero (aprovecha el caché de Docker)
COPY finansecure-web/package*.json ./
RUN npm install

# Copiar el resto del código y compilar
COPY finansecure-web/ .
RUN npm run build

# --- ETAPA 2: Servidor Web (Producción) ---
FROM nginx:alpine

LABEL maintainer="FinanSecure Team"
LABEL version="1.1"
LABEL description="FinanSecure Frontend - Angular 17+ (Optimized)"

# Limpiar contenido por defecto de nginx
RUN rm -rf /usr/share/nginx/html/*

# Copiar configuración de nginx (desde el contexto de build)
COPY finansecure-web/nginx.conf /etc/nginx/nginx.conf

# COPIAR DESDE LA ETAPA DE BUILD (Aquí está el truco)
# Ajustamos la ruta según donde Angular genera los archivos
COPY --from=build-stage /app/dist/finansecure-web/browser/ /usr/share/nginx/html

# Renombrar index.csr.html a index.html para SPA
RUN if [ -f /usr/share/nginx/html/index.csr.html ]; then mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; fi

# Crear usuario non-root y permisos
RUN addgroup -g 1001 appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown appuser:appgroup /var/run/nginx.pid && \
    apk add --no-cache curl

# Puerto
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD curl -f http://localhost/health || exit 1

# Usuario non-root
USER appuser

# Comando para iniciar nginx
CMD ["nginx", "-g", "daemon off;"]