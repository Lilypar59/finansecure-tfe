# ------------------------------------------------------------------------------
# ETAPA 1: Compilación (Build)
# ------------------------------------------------------------------------------
FROM node:18-alpine AS build-stage

# Directorio de trabajo dentro del contenedor
WORKDIR /app

# 1. Copiar archivos de definición de dependencias
# Usamos el comodín * para asegurar que se copien package.json y package-lock.json
COPY package*.json ./

# 2. Instalar dependencias (Limpio y rápido)
RUN npm install

# 3. Copiar TODO el código fuente del proyecto al contenedor
COPY . .

# 4. Compilar la aplicación para producción
# Esto generará la carpeta /app/dist/finansecure-web/browser
RUN npm run build

# ------------------------------------------------------------------------------
# ETAPA 2: Servidor Web (Producción con Nginx)
# ------------------------------------------------------------------------------
FROM nginx:alpine

LABEL maintainer="FinanSecure Team"
LABEL version="1.2"

# Limpiar el directorio por defecto de Nginx
RUN rm -rf /usr/share/nginx/html/*

# 1. Copiar tu configuración personalizada de Nginx
# IMPORTANTE: Asegúrate que nginx.conf esté en la misma carpeta que este Dockerfile
COPY nginx.conf /etc/nginx/nginx.conf

# 2. Copiar los archivos compilados desde la etapa anterior (build-stage)
# La ruta /app/dist/... debe coincidir con la estructura de tu proyecto Angular
COPY --from=build-stage /app/dist/finansecure-web/browser /usr/share/nginx/html

# 3. Soporte para SPA (Single Page Application)
# Renombrar index.csr.html a index.html si existe (común en Angular 17+)
RUN if [ -f /usr/share/nginx/html/index.csr.html ]; then \
    mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; \
    fi

# 4. Seguridad: Configurar usuario no-root y permisos
RUN addgroup -g 1001 appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown appuser:appgroup /var/run/nginx.pid && \
    apk add --no-cache curl

# Exponer el puerto estándar
EXPOSE 80

# Monitoreo de salud
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD curl -f http://localhost/health || exit 1

# Cambiar al usuario seguro
USER appuser

# Iniciar Nginx
CMD ["nginx", "-g", "daemon off;"]